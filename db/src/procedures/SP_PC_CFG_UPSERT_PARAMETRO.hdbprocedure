PROCEDURE "SP_PC_CFG_UPSERT_PARAMETRO" (
    IN P_ID_PARAM NVARCHAR(64),
    IN P_VALOR NVARCHAR(500),
    IN P_DESCRIPCION NVARCHAR(500),
    OUT P_RESULTADO INT
)
LANGUAGE SQLSCRIPT
SQL SECURITY INVOKER
AS
BEGIN
    DECLARE V_EXISTS INT;

    SELECT COUNT(1) INTO V_EXISTS
        FROM T_PC_CFG_PARAMETROS
    WHERE ID_PARAM = :P_ID_PARAM;

    UPSERT T_PC_CFG_PARAMETROS
        (ID_PARAM, VALOR, DESCRIPCION, UPDATED_AT)
        VALUES (:P_ID_PARAM, _:P_VALOR, :P_DESCRIPCION, CURRENT_UTCTIMESTAMP)
        WITH PRIMARY KEY;
    
    IF :V_EXISTS > 0 THEN
        P_RESULTADO := 2;
    ELSE
        P_RESULTADO := 1;
    END IF
END;
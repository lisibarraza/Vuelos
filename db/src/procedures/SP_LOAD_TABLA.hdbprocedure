PROCEDURE "SP_LOAD_TABLA"( )
    LANGUAGE SQLSCRIPT
    SQL SECURITY INVOKER
AS
BEGIN
    DECLARE RECORDS_COUNT INTEGER;
    DECLARE JOB_START_TIME SECONDDATE;
    DECLARE JOB_END_TIME SECONDDATE;
    DECLARE APP_USER NVARCHAR(200);
    DECLARE FECHA_CORTE DATE;
    DECLARE MES_ACTUAL INTEGER;

    DECLARE EXIT HANDLER FOR SQLEXCEPTION

    INSERT INTO "T_DATA_INTEGRATION_LOG"(
        "JOB_NAME",
        "JOB_START_TIME",
        "JOB_END_TIME",
        "JOB_EXECUTION_TIME",
        "JOB_FREQUENCY",
        "SOURCE_DATASET",
        "TARGET_DATASET",
        "RECORDS_WRITTEN",
        "APPLICATION_USER",
        "JOB_STATUS",
        "JOB_ERROR_CODE",
        "JOB_ERROR_MESSAGE"
    )VALUES(
      'SP_LOAD_TABLA' ,
      :JOB_START_TIME,
      NULL,
      1,
      'FUENTE',
      'DESTINO',
      0,
      :APP_USER,
      'FAILURE',
      ::SQL_ERROR_CODE,
      ::SQL_ERROR_MESSAGE
    );

    ---SE GUARDA LA FECHA DE INICIO DE LA EJECUCIÓN DEL SP
    SELECT CAST(CURRENT_UTCTIMESTAMP AS SECONDDATE) INTO JOB_START_TIME
    FROM DUMMY;

    ---SE GUARDA EL CONTEO DE REGISTROS
    SELECT COUNT(1) INTO RECORDS_COUNT
    FROM TABLA

    UPSERT "TABLA" (
        "CAMPO1",
        "CAMPO2",
        "CAMPO3",
        "CAMPO4",
        "CAMPO5",
        "CAMPO6",
        "CAMPON",
    )
    SELECT '1', '2', '3', '4', '5', '6' FROM DUMMY;

    ---COMMIT PARA GUARDAR LOS DATOS
    COMMIT;

     ---SE GUARDA LA FECHA DE FIN DE LA EJECUCIÓN DEL SP
    SELECT CAST(CURRENT_UTCTIMESTAMP AS SECONDDATE) INTO JOB_END_TIME
    FROM DUMMY;

    ---SE GUARDA EL USUARIO QUE EJECUTA
    SELECT SESSION_CONTEXT('APPLICATIONUSER') INTO APP_USER
    FROM DUMMY;

    ---INSERTA INFORMACION CORRECTA EN LOG
    INSERT INTO "T_DATA_INTEGRATION_LOG"(
        "JOB_NAME",
        "JOB_START_TIME",
        "JOB_END_TIME",
        "JOB_EXECUTION_TIME",
        "JOB_FREQUENCY",
        "SOURCE_DATASET",
        "TARGET_DATASET",
        "RECORDS_WRITTEN",
        "APPLICATION_USER",
        "JOB_STATUS",
        "JOB_ERROR_CODE",
        "JOB_ERROR_MESSAGE"
    )VALUES(
      'SP_LOAD_TABLA' ,
      :JOB_START_TIME,
      :JOB_END_TIME,
      1,
      'FUENTE',
      'DESTINO',
      0,
      :APP_USER,
      'SUCCESS',
      NULL,
      NULL
    );


    ---COMMIT PARA GUARDAR LOS DATOS DEL LOG
    COMMIT;


END;
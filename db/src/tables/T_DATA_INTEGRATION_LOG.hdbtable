COLUMN TABLE "T_DATA_INTEGRATION_LOG"(
    "SOURCE_CD" INT,
    "DOMINIO" NVARCHAR(100),
    "JOB_NAME" NVARCHAR(100),
    "JOB_START_TIME" SECONDDATE,
    "JOB_END_TIME" SECONDDATE,
    "JOB_EXECUTION_TIME" TIME,
    "JOB_FREQUENCY" INT DEFAULT 1,
    "SOURCE_DATASET" NVARCHAR(5000),
    "TARGET_DATASET" NVARCHAR(5000),
    "SOURCE_RECORDS" INT,
    "TARGET_RECORDS" INT,
    "RECORDS_WRITTEN" INT,
    "UPDATED_RECORDS" INT,
    "APPLICATION_USER" NVARCHAR(100),
    "ORCHESTRATOR" NVARCHAR(100),
    "JOB_STATUS" NVARCHAR(100),
    "JOB_ERROR_CODE"  NVARCHAR(4000),
    "JOB_ERROR_MESSAGE"  NVARCHAR(4000),
    "FUENTE"  NVARCHAR(4000),
    "DESCRIPCION_FUNCIONAL" NVARCHAR(5000),
    "HISTORICO" NVARCHAR(5000),
    "CAMPO_FECHA" NVARCHAR(5000),
    "FRECUENCIA_ACTUALIZACION" NVARCHAR(5000),
    "LAGO_DATOS" NVARCHAR(5000),
    "TABLA_LAGO" NVARCHAR(5000)
) PAGE LOADABLE